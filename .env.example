# Contact form. Without these the form tells visitors to email directly
# rather than failing silently.
RESEND_API_KEY=
# A verified sender on your Resend domain, e.g. "Marco Milad <hello@marcomilad.dev>"
CONTACT_FROM_EMAIL=

# Set to 1 only for a local production build when you want to see /specimen.
# Never set this in the Vercel project.
SPECIMEN=
